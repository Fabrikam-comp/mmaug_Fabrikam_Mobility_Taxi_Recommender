# Copy this file to .env and fill in the lines marked TODO.
# NEVER commit .env (check that it is listed in .gitignore).
# One line per setting, no spaces around the = sign.
# This is a LOCAL environment. It does not need to match GitHub, which you cannot read back.

# ---- Login (already filled in, taken from your decoded ID token) ----
AUTH_MODE=token
AUTH_ACCEPT_ACCESS_TOKEN=false
AUTH_ACCEPT_ID_TOKEN=true
AZURE_AD_TENANTID=71beefd7-29f4-4b9e-9cb2-e78b5dc851ad
AZURE_AD_CLIENTID=035aa2cc-3b23-40fe-9654-a1c07b18fb8a
# TODO make a new random value: uv run python -c "import secrets; print(secrets.token_hex(32))"
# To get the same user IDs as the deployed app, overwrite the GitHub secret with this same value.
USER_ID_HMAC_KEY=f058d0ead378ed6fa368de17a069d718acf64b950de64c14

# ---- Cosmos DB (your real Azure account) ----
# TODO Azure portal, Cosmos account fabrikam-taxi-cosmos, Keys page: URI and Primary Key
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=fabrikam
COSMOS_CONTAINER_TRIPS=trips

# ---- Place search ----
# TODO your own email
GEOCODER_CONTACT=
# TODO Geoapify project, API keys page: make a SECOND key restricted to http://localhost:5500
GEOAPIFY_API_KEY=

# ---- Taxi providers (made up, local only). The mocks run inside the API and read these. ----
BOLT_CLIENT_ID=bolt-local-id
BOLT_CLIENT_SECRET=bolt-local-secret
UBER_SERVER_TOKEN=uber-local-token
ECABS_API_KEY=ecabs-local-key
# Leave empty to keep the fault switch closed.
MOCK_ADMIN_KEY=
